<Window x:Class="GameRealisticMap.Studio.Modules.Arma3WorldEditor.Views.MassEdit.SnapToGroundView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:geminibehaviors="clr-namespace:Gemini.Framework.Behaviors;assembly=Gemini"
        xmlns:r="clr-namespace:GameRealisticMap.Studio"
        Background="{DynamicResource EnvironmentWindowBackground}"
        Foreground="{DynamicResource EnvironmentWindowText}"
        Width="560" Height="380" MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="Coller les objets au sol">
    <behaviors:Interaction.Behaviors>
        <geminibehaviors:WindowOptionsBehavior ShowIcon="False"
                                               ShowMinimizeBox="False"
                                               ShowMaximizeBox="False" />
    </behaviors:Interaction.Behaviors>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0 0 0 12"
                   Text="Recolle au sol les objets qui flottent en l'air (par exemple après un import ou une modification du relief). Seuls les objets situés au-dessus du sol de plus de la distance indiquée sont déplacés." />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 8">
            <TextBlock VerticalAlignment="Center" Width="220" Text="Filtre modèle (vide = tous les objets) :" />
            <TextBox Width="220" VerticalAlignment="Center" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 8">
            <TextBlock VerticalAlignment="Center" Margin="0 0 8 0" Text="Ajout rapide par type :" />
            <Button Padding="10 4" Margin="2 0" cal:Message.Attach="SetPreset('tree')"><Run Text="Arbres" /></Button>
            <Button Padding="10 4" Margin="2 0" cal:Message.Attach="SetPreset('bush')"><Run Text="Buissons" /></Button>
            <Button Padding="10 4" Margin="2 0" cal:Message.Attach="SetPreset('rock')"><Run Text="Rochers" /></Button>
            <Button Padding="10 4" Margin="2 0" cal:Message.Attach="SetPreset('')"><Run Text="Tous" /></Button>
        </StackPanel>

        <CheckBox Grid.Row="3" Margin="0 0 0 8" IsChecked="{Binding IsPattern}"
                  Content="Par type (motif) — le filtre est un morceau du chemin du modèle" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0 0 0 8">
            <TextBlock VerticalAlignment="Center" Width="220" Text="Distance minimale au sol (m) :" />
            <TextBox Width="80" VerticalAlignment="Center" Text="{Binding MinDistance}" />
        </StackPanel>

        <CheckBox Grid.Row="5" Margin="0 0 0 8" IsChecked="{Binding IncludeBuried}"
                  Content="Remonter aussi les objets enterrés sous le sol" />

        <Grid Grid.Row="7" Margin="0 12 0 0" HorizontalAlignment="Right" IsSharedSizeScope="True">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Margin" Value="6 0 0 0" />
                    <Setter Property="Padding" Value="15 7" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition SharedSizeGroup="WindowButtons" />
                <ColumnDefinition SharedSizeGroup="WindowButtons" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" MinWidth="80" cal:Message.Attach="Process">
                <Run Text="{x:Static r:Labels.ApplyChanges}"/>
            </Button>
            <Button Grid.Column="1" IsCancel="True" MinWidth="80" cal:Message.Attach="Cancel">
                <Run Text="{x:Static r:Labels.Cancel}"/>
            </Button>
        </Grid>
    </Grid>
</Window>
