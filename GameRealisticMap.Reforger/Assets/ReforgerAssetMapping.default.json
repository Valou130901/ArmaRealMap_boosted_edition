// Maps Arma 3 model names (file name without extension) to Arma Reforger prefab ResourceNames.
// A ResourceName looks like "{GUID}Prefabs/.../name.et". Every GUID below was read out of the
// vanilla Arma Reforger resourceDatabase.rdb, not guessed.
//
// Resolution order: exact match first, then the first keyword rule whose any token appears in the
// model name, then the global fallback.
//
// Arma 3 Mediterranean flora has no counterpart in Reforger, whose vegetation set is central
// European. Species are matched on silhouette and volume, not botany: ficus to hornbeam, olive to
// apple, cypress to spruce, oleander to elder. Limestone is matched to granite for the same reason.
//
// Buildings are deliberately left unmapped: Reforger has no Mediterranean housing, and an
// approximation would be worse than a gap. They come out in port-worklist.csv for the model port
// pipeline. Models with no mapping are exported as 7-token lines with no prefab.
//
// To add a prefab: in Enfusion Resource Manager, right-click the .et and Copy resource name.
{
  "exact": {
    // Trees: Malden broadleaves and cypresses, by size class
    "t_ficusb1s_f": "{F89B942712FD22D6}Prefabs/Vegetation/Tree/t_carpinus_betulus/t_carpinus_betulus_2s.et",
    "t_ficusb2s_f": "{8F91FCAFE65FCDA6}Prefabs/Vegetation/Tree/t_carpinus_betulus/t_carpinus_betulus_3s.et",
    "t_ficus_3d_f": "{B5D57F1F1C796A66}Prefabs/Vegetation/Tree/t_carpinus_betulus/t_carpinus_betulus_3d.et",
    "t_oleae1s_f": "{1C6F9AD2669C17F9}Prefabs/Vegetation/Tree/t_malus_domestica/t_malus_domestica_2s.et",
    "t_oleae2s_f": "{1C6F9AD2669C17F9}Prefabs/Vegetation/Tree/t_malus_domestica/t_malus_domestica_2s.et",
    "t_broussonetiap1s_f": "{1C6F9AD2669C17F9}Prefabs/Vegetation/Tree/t_malus_domestica/t_malus_domestica_2s.et",
    "t_cupressus_stricta_2s_f": "{A975A81D02F4862C}Prefabs/Vegetation/Tree/t_picea_abies/t_picea_abies_2s.et",
    "t_cupressus_stricta_3s_f": "{DE7FC095F656695C}Prefabs/Vegetation/Tree/t_picea_abies/t_picea_abies_3s.et",
    "t_fraxinusav2s_f": "{C46F2709EDF643D4}Prefabs/Vegetation/Tree/t_tilia_cordata/t_tilia_cordata_3s.et",

    // Bushes: oleander and shrub ficus to elder and hazel, grapevine to a low sprawling bush
    "b_neriumo2d_f": "{BAB8054438C72A04}Prefabs/Vegetation/Bush/b_sambucus_nigra_2.et",
    "b_neriumo2s_f": "{D6EC31A48403A52A}Prefabs/Vegetation/Bush/b_sambucus_nigra_1.et",
    "b_neriumo2s_white_f": "{D6EC31A48403A52A}Prefabs/Vegetation/Bush/b_sambucus_nigra_1.et",
    "b_ficusc1s_f": "{C98A6C1C2372354E}Prefabs/Vegetation/Bush/b_corylus_avellana_1.et",
    "b_ficusc2s_f": "{A5DE58FC9FB6BA60}Prefabs/Vegetation/Bush/b_corylus_avellana_2.et",
    "b_ficusc2d_f": "{A5DE58FC9FB6BA60}Prefabs/Vegetation/Bush/b_corylus_avellana_2.et",
    "b_vitis_vinifera_f": "{0CA0547EB03759E1}Prefabs/Vegetation/Bush/b_rubus_idaeus_1s.et",
    "b_opuntiaficusindica3s_f": "{F55BF63BAD1DCB7E}Prefabs/Vegetation/Bush/b_juniperus_communis_2s.et",

    // Rocks: Malden limestone to granite, same silhouette family
    "limestone_01_01_lc_f": "{3F68EE5DCB004B10}Prefabs/Rocks/Granite/GraniteCliff_01.et",
    "limestone_01_02_lc_f": "{533CDABD77C4C43E}Prefabs/Rocks/Granite/GraniteCliff_02.et",
    "limestone_01_03_lc_f": "{B6A096447B215355}Prefabs/Rocks/Granite/GraniteCliff_03.et",
    "limestone_01_01_f": "{9633134198F3AB1A}Prefabs/Rocks/Granite/GraniteRock_01.et",
    "limestone_01_02_f": "{FA6727A124372434}Prefabs/Rocks/Granite/GraniteRock_02.et",
    "limestone_01_03_f": "{1FFB6B5828D2B35F}Prefabs/Rocks/Granite/GraniteRock_03.et",
